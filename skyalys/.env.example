# URL publique du site (sans slash final), utilisee pour le SEO, le sitemap et les balises canoniques
NEXT_PUBLIC_SITE_URL=https://skyalys.eu

# Optionnel : envoi des emails (commandes, devis, comptes pro, contact) via Resend
RESEND_API_KEY=
ORDERS_EMAIL_TO=commandes@skyalys.eu
EMAIL_FROM=Skyalys <no-reply@skyalys.eu>

# Paiement en ligne (Stripe Checkout). Sans cle, l'option carte s'affiche "bientot disponible".
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (evenement checkout.session.completed vers /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
